# Copy this file to .env and fill in the values before running locally.
# .env is gitignored; never commit real secrets.

# Required: secret used to sign and verify JWTs. Use a long random string.
JWT_SECRET=

# AWS region where the DynamoDB tables and S3 bucket live (default: us-east-1)
AWS_REGION=us-east-1

# DynamoDB table name for users (default: users)
USERS_TABLE=users

# DynamoDB table name for study resources (default: Resources)
RESOURCES_TABLE=Resources

# S3 bucket that uploaded files (PDF/DOC/DOCX/MP4) are stored in
UPLOADS_BUCKET=csye6225-study-resources-926909118634

# Port the Express server listens on (default: 3000)
PORT=3000
