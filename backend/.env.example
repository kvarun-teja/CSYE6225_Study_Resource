# Copy this file to .env and fill in the values before running locally.
# .env is gitignored; never commit real secrets.

# Required: secret used to sign and verify JWTs. Use a long random string.
JWT_SECRET=

# AWS region where the DynamoDB users table lives (default: us-east-1)
AWS_REGION=us-east-1

# DynamoDB table name for users (default: users)
USERS_TABLE=users

# Port the Express server listens on (default: 3000)
PORT=3000
